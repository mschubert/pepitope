#!/bin/sh

if test -z "${R_HOME}"; then
    R_HOME=`R RHOME`
fi

RSCRIPT="${R_HOME}/bin${R_ARCH_BIN}/Rscript"

PKG_CPPFLAGS=`"${RSCRIPT}" -e "cat(Rhtslib::pkgconfig('PKG_CPPFLAGS'))"` || exit 1
PKG_LIBS=`"${RSCRIPT}" -e "cat(Rhtslib::pkgconfig('PKG_LIBS'))"` || exit 1

cat > src/Makevars.win <<EOF
PKG_CPPFLAGS = ${PKG_CPPFLAGS}
PKG_LIBS = ${PKG_LIBS}
EOF
